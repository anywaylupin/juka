# Session secret for nuxt-auth-utils. Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Only needed for `wrangler --remote` commands and deploys.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Signing in with a provider. Optional: with a pair missing, that button is not
# rendered at all, and the app is username and password only.
#
# https://github.com/settings/developers
# GitHub: Settings > Developer settings > OAuth Apps > New OAuth App.
#   Callback URL http://localhost:3000/auth/github in development,
#   https://your-domain/auth/github in production.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Google: http://console.cloud.google.com > APIs & Services > Credentials > OAuth client ID.
#   Authorised redirect URI http://localhost:3000/auth/google, and the production one.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Sending the one email this app sends, a password reset link. Optional: with
# these empty the link is written to the server log instead, which is what
# development wants and what a missing key in production is visible as.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=

# Where this deployment lives, used to build the reset link. Empty falls back to
# the request origin, which is correct in development and is not trusted in
# production, because a Host header is attacker controlled.
NUXT_PUBLIC_SITE_URL=
